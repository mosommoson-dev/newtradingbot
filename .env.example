# ============================================================================
# EUR/USD Quant Trading Bot - environment configuration
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================================

# ----- Runtime mode -----
# backtest | paper | live | walkforward | montecarlo | research
BOT_MODE=paper

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ----- OANDA -----
# practice  -> https://api-fxpractice.oanda.com
# live      -> https://api-fxtrade.oanda.com
OANDA_ENV=practice
OANDA_TOKEN=replace-with-your-oanda-personal-access-token
OANDA_ACCOUNT_ID=101-001-XXXXXXX-001

# ----- PostgreSQL / TimescaleDB -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forex_bot
DB_USER=trader
DB_PASSWORD=change-me

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379

# ----- Telegram -----
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id

# ----- FRED (macro data) -----
FRED_API_KEY=replace-with-your-fred-key

# ----- Risk parameters (override defaults from config/settings.py) -----
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.02
MAX_TOTAL_DRAWDOWN=0.05
EMERGENCY_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=3
MAX_SPREAD_PIPS=1.5

# ----- Dashboard -----
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
